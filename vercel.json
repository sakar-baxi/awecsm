{
  "version": 2,
  "regions": ["bom1"],
  "functions": {
    "api/health/live.js": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/auth/login.js": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/auth/me.js": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/health/live", "destination": "/api/health/live.js" },
    { "source": "/api/auth/login", "destination": "/api/auth/login.js" },
    { "source": "/api/auth/me", "destination": "/api/auth/me.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
